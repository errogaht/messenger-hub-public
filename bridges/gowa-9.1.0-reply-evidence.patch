+// StoredReplyID records observed native quote context, including an explicit empty
+// value for messages without quotes. Legacy storage rows remain nil/unknown.
+func StoredReplyID(msg *waE2E.Message) *string {
+	if msg == nil {
+		return nil
+	}
+	id := ExtractContextInfo(msg).GetStanzaID()
+	return &id
+}
