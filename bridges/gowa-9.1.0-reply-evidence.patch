diff --git a/src/infrastructure/chatstorage/sqlite_repository_test.go b/src/infrastructure/chatstorage/sqlite_repository_test.go
index d89cea7..5ec0a1c 100644
--- a/src/infrastructure/chatstorage/sqlite_repository_test.go
+++ b/src/infrastructure/chatstorage/sqlite_repository_test.go
@@ -393,3 +393,32 @@ func countMessageReactions(t *testing.T, repo *SQLiteRepository) int {
 	}
 	return count
 }
+
+// Native quote evidence survives both live and batch persistence, while old rows
+// remain unknown. Identical IDs on another device must never share quote context.
+func TestNativeQuoteRoundtrip(t *testing.T) {
+	repo := newTestSQLiteRepository(t)
+	quote := "original"
+	for _, device := range []string{"a", "b"} {
+		m := &domainChatStorage.Message{ID: "media", DeviceID: device, ChatJID: "chat", Content: "caption", MediaType: "image", Timestamp: time.Now()}
+		if device == "a" {
+			m.ReplyMessageID = &quote
+		}
+		if err := repo.StoreMessage(m); err != nil {
+			t.Fatal(err)
+		}
+		if err := repo.StoreMessagesBatch([]*domainChatStorage.Message{m}); err != nil {
+			t.Fatal(err)
+		}
+		got, err := repo.GetMessageByIDAndDevice(device, "media")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if device == "a" && (got.ReplyMessageID == nil || *got.ReplyMessageID != quote) {
+			t.Fatal("quote lost")
+		}
+		if device == "b" && got.ReplyMessageID != nil {
+			t.Fatal("cross-device quote leak")
+		}
+	}
+}
