 }
+
+// Every media subtype carries the same native stanza ID; no-caption voice must
+// not be treated as missing quote evidence merely because it has no text.
+func TestStoredReplyIDMedia(t *testing.T) {
+	for _, m := range []*waE2E.Message{
+		{ImageMessage: &waE2E.ImageMessage{ContextInfo: &waE2E.ContextInfo{StanzaID: proto.String("quote")}}},
+		{DocumentMessage: &waE2E.DocumentMessage{ContextInfo: &waE2E.ContextInfo{StanzaID: proto.String("quote")}}},
+		{AudioMessage: &waE2E.AudioMessage{ContextInfo: &waE2E.ContextInfo{StanzaID: proto.String("quote")}}},
+		{VideoMessage: &waE2E.VideoMessage{ContextInfo: &waE2E.ContextInfo{StanzaID: proto.String("quote")}}},
+	} {
+		if id := StoredReplyID(m); id == nil || *id != "quote" {
+			t.Fatal("missing native quote")
+		}
+	}
+	if StoredReplyID(nil) != nil {
+		t.Fatal("nil proto must remain unknown")
+	}
+	if id := StoredReplyID(&waE2E.Message{}); id == nil || *id != "" {
+		t.Fatal("observed no-quote message must be known empty")
+	}
+}
